# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA build folders
/.next-qa*

# Photo generation: personal reference photos and full-size generated originals stay local
/art/references/
/art/generated/
/art/style/

# Working material stays on this Mac, out of the public repo: planning and research notes,
# design history, and the Gemini photo tool.
/docs/
/tools/
/art/
